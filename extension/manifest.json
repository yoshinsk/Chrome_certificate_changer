{
  "manifest_version": 3,
  "name": "法人別 証明書切替",
  "version": "0.3.0",
  "description": "Windows の電子証明書を法人ごとに登録し、今のタブや法人専用のウィンドウで銀行を開きます。対応するページでは、接続先が通知した証明書を確認できます。",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting"],
  "action": { "default_title": "法人別 証明書切替", "default_popup": "panel.html" },
  "options_page": "panel.html"
}
